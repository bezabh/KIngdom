# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# PAYPAL PAYMENT & SUBSCRIPTION SYSTEM (PAYPAL-ONLY)
# =========================================================================
# PAYPAL_MODE: Set to "sandbox" for testing (default) or "live" for production.
# IMPORTANT: Do NOT switch to "live" without explicit administrator confirmation.
PAYPAL_MODE="sandbox"
PAYPAL_LIVE_ENABLED="false"

# Sandbox Credentials (PayPal Developer Dashboard -> Sandbox App)
PAYPAL_SANDBOX_CLIENT_ID=""
PAYPAL_SANDBOX_CLIENT_SECRET=""
PAYPAL_SANDBOX_WEBHOOK_ID=""
# Optional pre-created PayPal Business Dashboard Plan IDs (Sandbox)
PAYPAL_SANDBOX_PLAN_MONTHLY_ID=""
PAYPAL_SANDBOX_PLAN_YEARLY_ID=""

# Live Production Credentials (OPTIONAL in Sandbox mode)
# Required ONLY when switching to production (PAYPAL_MODE="live" and PAYPAL_LIVE_ENABLED="true").
# Sandbox checkout and subscriptions work without Live credentials.
PAYPAL_LIVE_CLIENT_ID=""
PAYPAL_LIVE_CLIENT_SECRET=""
PAYPAL_LIVE_WEBHOOK_ID=""
# Optional pre-created PayPal Business Dashboard Plan IDs (Live)
PAYPAL_LIVE_PLAN_MONTHLY_ID=""
PAYPAL_LIVE_PLAN_YEARLY_ID=""

# Configurable Subscription Plan Pricing (Server-Side Controlled)
PAYPAL_PRO_MONTHLY_PRICE="9.99"
PAYPAL_PRO_YEARLY_PRICE="79.99"
PAYPAL_CURRENCY="EUR"
PAYPAL_ENABLE_ONE_TIME_FALLBACK="true"

# Administrator Emails (comma-separated verified emails allowed to access Admin Payment Dashboard)
ADMIN_EMAILS="beckylove2004@gmail.com"

# PAYMENT_SECRET_KEY: Server-side cryptographic signing key for entitlement tokens.
PAYMENT_SECRET_KEY="axumite_sovereign_secure_key_2026"

# PORT: Server HTTP port (defaults to 3000 locally; Cloud Run injects PORT automatically).
PORT="3000"

# NODE_ENV: Set to "production" for deployed web builds.
NODE_ENV="production"

# ALLOWED_ORIGINS: Optional comma-separated list of allowed CORS origins for deployed web clients.
ALLOWED_ORIGINS=""
