<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDark"
    tools:context=".GeezCameraOcrActivity">

    <!-- Top Action Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/ocrToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurfaceDark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnOcrBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorGold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/ocr_screen_title"
                android:textColor="@color/colorGold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnToggleFlash"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_flash"
                android:src="@drawable/ic_flashlight"
                app:tint="@color/colorGold" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Camera Preview Frame with Golden Reticle -->
    <FrameLayout
        android:id="@+id/cameraPreviewFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#05030A"
        app:layout_constraintBottom_toTopOf="@+id/ocrBottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ocrToolbar">

        <!-- Scanning Reticle / Bounding Box -->
        <View
            android:id="@+id/viewReticle"
            android:layout_width="280dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ocr_viewfinder" />

        <TextView
            android:id="@+id/tvReticleHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="Align Ge'ez inscription or Tigrinya text in reticle"
            android:textColor="@color/colorGoldLight"
            android:textSize="11sp" />

        <!-- Scanning Laser Line Indicator -->
        <View
            android:id="@+id/laserScanLine"
            android:layout_width="260dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@color/colorGold"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- Bottom Controls & Result Card -->
    <LinearLayout
        android:id="@+id/ocrBottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorSurfaceDark"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Mode Selector Radio / Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabOcrTarget"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@color/colorSurfaceCard"
            app:tabIndicatorColor="@color/colorGold"
            app:tabSelectedTextColor="@color/colorGold"
            app:tabTextColor="@color/colorTextSecondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manuscript" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monument Stela" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document" />

        </com.google.android.material.tabs.TabLayout>

        <!-- OCR Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOcrResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/colorSurfaceCard"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/colorGoldBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvOcrResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recognized Text / ትርጉም"
                    android:textColor="@color/colorGold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOcrResultContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="«ንጉሠ ነገሥት ዘኢትዮጵያ» — Ancient Ezana Stone Inscription"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Shutter Capture Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCaptureOcr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/action_capture_ocr"
                android:src="@drawable/ic_camera_scan"
                app:backgroundTint="@color/colorGold"
                app:fabSize="normal"
                app:tint="@color/colorTextDark" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
