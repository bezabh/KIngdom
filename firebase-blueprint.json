{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Axumite AI User profile, subscription status, and role authority",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "authUid": { "type": "string" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "accountCreatedAt": { "type": "string" },
        "role": { "type": "string", "enum": ["Creator", "Guest", "Admin", "User", "Axumite Sovereign Scholar", "ኣክሱማይት AI Pro", "Free Member"] },
        "phoneNumber": { "type": "string" },
        "isEmailVerified": { "type": "boolean" },
        "isPhoneVerified": { "type": "boolean" },
        "tokensRemaining": { "type": "number" },
        "preferredLanguage": { "type": "string" },
        "voicePersona": { "type": "string", "enum": ["ancient_historian", "modern_advisor", "technical_consultant", "cultural_custodian", "concise_executive"] },
        "voicePersonaPitch": { "type": "number" },
        "voicePersonaRate": { "type": "number" },
        "avatar": { "type": "string" },
        "storageUsedBytes": { "type": "number" },
        "storageQuotaBytes": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "UserFile": {
      "title": "UserFile",
      "description": "User uploaded documents, manuscripts, audio clips, and images with metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string" },
        "category": { "type": "string", "enum": ["document", "image", "audio", "geez_script", "video", "other"] },
        "fileData": { "type": "string" },
        "description": { "type": "string" },
        "uploadDate": { "type": "string" },
        "updatedAt": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["id", "userId", "fileName", "fileSize", "uploadDate"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "Tigrinya AI chat conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "mode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "createdAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Sovereign subscription and token refill payment receipt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "string" },
        "currency": { "type": "string" },
        "bankName": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "referenceNumber", "status"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "Verified PayPal recurring subscription state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "provider": { "type": "string", "enum": ["paypal", "stripe"] },
        "paypalSubscriptionId": { "type": "string" },
        "paypalPlanId": { "type": "string" },
        "planType": { "type": "string", "enum": ["pro_monthly", "pro_yearly"] },
        "status": { "type": "string" },
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "billingFrequency": { "type": "string", "enum": ["MONTH", "YEAR"] },
        "startDate": { "type": "string" },
        "nextBillingDate": { "type": "string" },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "provider", "paypalSubscriptionId", "paypalPlanId", "planType", "status", "currency", "amount", "billingFrequency", "startDate", "cancelAtPeriodEnd", "updatedAt"]
    },
    "PayPalPaymentHistory": {
      "title": "PayPalPaymentHistory",
      "description": "Verified PayPal transaction history record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "provider": { "type": "string", "enum": ["paypal", "stripe"] },
        "paypalTransactionId": { "type": "string" },
        "paypalSubscriptionId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["COMPLETED", "PENDING", "FAILED", "REFUNDED", "REVERSED"] },
        "paymentDate": { "type": "string" }
      },
      "required": ["uid", "provider", "paypalTransactionId", "paypalSubscriptionId", "amount", "currency", "paymentStatus", "paymentDate"]
    },
    "UserEntitlement": {
      "title": "UserEntitlement",
      "description": "Server-authoritative Pro feature entitlements synced from PayPal status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "isPro": { "type": "boolean" },
        "features": { "type": "array" },
        "subscriptionStatus": { "type": "string" },
        "expiresAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "plan", "isPro", "features", "subscriptionStatus", "updatedAt"]
    },
    "PayPalWebhookEvent": {
      "title": "PayPalWebhookEvent",
      "description": "Idempotent PayPal webhook event tracking record",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventType": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["eventId", "eventType", "processedAt"]
    },
    "PaymentAuditLog": {
      "title": "PaymentAuditLog",
      "description": "Immutable server payment security audit log",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "uid": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "Saved translations, prompts, insights, and calligraphy items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "content", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support and inquiry ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerId", "subject", "status", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Axumite AI system configuration and feature flags",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "appSubtitle": { "type": "string" },
        "defaultLanguage": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceNotice": { "type": "string" },
        "publicSignUp": { "type": "boolean" },
        "enableGuestMode": { "type": "boolean" },
        "enableVoiceSynthesis": { "type": "boolean" },
        "enableImageRecognition": { "type": "boolean" },
        "enablePromptForge": { "type": "boolean" },
        "enableProClickEarning": { "type": "boolean" },
        "defaultModel": { "type": "string" },
        "aiTemperature": { "type": "number" },
        "maxOutputTokens": { "type": "number" }
      },
      "required": ["appName", "defaultLanguage", "maintenanceMode"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app and push notification document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "titleTi": { "type": "string" },
        "titleEn": { "type": "string" },
        "bodyTi": { "type": "string" },
        "bodyEn": { "type": "string" },
        "category": { "type": "string" },
        "urgency": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "titleTi", "titleEn", "read", "timestamp"]
    },
    "SaasUsage": {
      "title": "SaasUsage",
      "description": "User SaaS daily AI quota, plan tier, lifetime requests, and reset state",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "premium", "enterprise"] },
        "dailyRequestsUsed": { "type": "number" },
        "dailyLimit": { "type": "number" },
        "totalRequestsLifetime": { "type": "number" },
        "lastResetDate": { "type": "string" },
        "status": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "paypalCustomerId": { "type": "string" },
        "renewalDate": { "type": "string" }
      },
      "required": ["userId", "plan", "dailyRequestsUsed", "dailyLimit"]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Tokenized saved payment methods (card last4, Telebirr, CBE Birr, Bank Wire, Google Pay, Apple Pay, PayPal). Never stores raw PAN or CVV.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authUid": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "type": { "type": "string", "enum": ["card", "telebirr", "cbe_birr", "google_pay", "apple_pay", "paypal", "bank_wire"] },
        "label": { "type": "string" },
        "providerBadge": { "type": "string" },
        "last4": { "type": "string" },
        "brand": { "type": "string", "enum": ["visa", "mastercard", "amex", "discover", "sovereign"] },
        "expiry": { "type": "string" },
        "holderName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "bankName": { "type": "string" },
        "swiftCode": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "type", "label", "providerBadge", "currency", "isDefault", "isVerified", "createdAt", "updatedAt"]
    },
    "VoiceTranslationLog": {
      "title": "VoiceTranslationLog",
      "description": "Real-time bidirectional voice translation loop turn log with source/target scripts, phonetics, and word breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "speaker": { "type": "string", "enum": ["A", "B"] },
        "sourceLanguage": { "type": "string", "maxLength": 64 },
        "targetLanguage": { "type": "string", "maxLength": 64 },
        "sourceTranscript": { "type": "string", "maxLength": 2000 },
        "translatedText": { "type": "string", "maxLength": 2000 },
        "spokenTargetText": { "type": "string", "maxLength": 2000 },
        "transliteration": { "type": "string", "maxLength": 2000 },
        "scriptName": { "type": "string", "maxLength": 100 },
        "culturalContext": { "type": "string", "maxLength": 1000 },
        "wordBreakdown": { "type": "array" },
        "latencyMs": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userEmail", "speaker", "sourceLanguage", "targetLanguage", "sourceTranscript", "translatedText", "timestamp", "createdAt"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "Two-person live conversation translator session transcript and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "personALang": { "type": "string", "maxLength": 64 },
        "personBLang": { "type": "string", "maxLength": 64 },
        "speechRate": { "type": "number" },
        "voiceProfile": { "type": "string", "maxLength": 40 },
        "turnCount": { "type": "number" },
        "transcriptSummary": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userEmail", "personALang", "personBLang", "turnCount", "createdAt", "updatedAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "In-app WebRTC live translated call session and subtitle transcript",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "roomCode": { "type": "string", "maxLength": 32 },
        "callType": { "type": "string", "enum": ["audio", "video"] },
        "localLanguage": { "type": "string", "maxLength": 64 },
        "remoteLanguage": { "type": "string", "maxLength": 64 },
        "durationSeconds": { "type": "number" },
        "subtitleCount": { "type": "number" },
        "transcriptText": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userEmail", "roomCode", "callType", "localLanguage", "remoteLanguage", "createdAt"]
    },
    "OcrDocument": {
      "title": "OcrDocument",
      "description": "Screen capture or multi-page Camera OCR scanned translation document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 160 },
        "captureSource": { "type": "string", "enum": ["screen_capture", "camera_ocr", "image_upload"] },
        "detectedLanguage": { "type": "string", "maxLength": 64 },
        "targetLanguage": { "type": "string", "maxLength": 64 },
        "pageCount": { "type": "number" },
        "originalText": { "type": "string", "maxLength": 4000 },
        "translatedText": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userEmail", "title", "captureSource", "targetLanguage", "originalText", "translatedText", "createdAt"]
    },
    "DownloadedLanguagePack": {
      "title": "DownloadedLanguagePack",
      "description": "Metadata for downloaded offline translation language pack",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "languageCode": { "type": "string", "maxLength": 24 },
        "languageName": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "maxLength": 32 },
        "sizeBytes": { "type": "number" },
        "entryCount": { "type": "number" },
        "downloadedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userEmail", "languageCode", "languageName", "version", "sizeBytes", "downloadedAt"]
    }
  },
  "firestore": {
    "/saas_usage/{userId}": {
      "schema": "SaasUsage",
      "description": "User SaaS daily quota and subscription plan record"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account profiles, authority tiers, and storage quotas"
    },
    "/users/{userId}/files/{fileId}": {
      "schema": "UserFile",
      "description": "User private uploaded files and metadata storage"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "ChatConversation",
      "description": "Tigrinya chat history per user"
    },
    "/users/{userId}/saved/{itemId}": {
      "schema": "SavedItem",
      "description": "User saved translation, prompts, and insights"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "User specific notifications and alerts"
    },
    "/users/{userId}/payment_methods/{methodId}": {
      "schema": "PaymentMethod",
      "description": "User tokenized saved payment methods (never stores raw card numbers or CVV)"
    },
    "/users/{userId}/voice_translation_logs/{logId}": {
      "schema": "VoiceTranslationLog",
      "description": "User real-time bidirectional voice translation loop history logs"
    },
    "/users/{userId}/conversation_sessions/{sessionId}": {
      "schema": "ConversationSession",
      "description": "Two-person live conversation translator sessions"
    },
    "/users/{userId}/call_sessions/{callId}": {
      "schema": "CallSession",
      "description": "In-app WebRTC translated call session history & transcripts"
    },
    "/users/{userId}/ocr_documents/{docId}": {
      "schema": "OcrDocument",
      "description": "Saved Screen Capture and Camera OCR multi-page translations"
    },
    "/users/{userId}/language_packs/{packId}": {
      "schema": "DownloadedLanguagePack",
      "description": "Downloaded offline translation pack registry per user"
    },
    "/userFiles/{fileId}": {
      "schema": "UserFile",
      "description": "Direct user files collection with security owner matching"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Verified transaction and token refill records"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "SubscriptionRecord",
      "description": "Verified PayPal subscription records"
    },
    "/payment_history/{paymentId}": {
      "schema": "PayPalPaymentHistory",
      "description": "Verified PayPal payment history records"
    },
    "/user_entitlements/{uid}": {
      "schema": "UserEntitlement",
      "description": "Server-authoritative Pro feature entitlements"
    },
    "/paypal_webhook_events/{eventId}": {
      "schema": "PayPalWebhookEvent",
      "description": "Idempotent PayPal webhook event deduplication store"
    },
    "/payment_audit_logs/{logId}": {
      "schema": "PaymentAuditLog",
      "description": "Server-side payment security & webhook audit logs"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support and inquiry ticket logs"
    },
    "/system/config": {
      "schema": "SystemConfig",
      "description": "System runtime settings and configuration"
    }
  }
}
